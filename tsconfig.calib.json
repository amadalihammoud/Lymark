{
  "//": "Compila apenas a geometria do carimbo para CommonJS, para que os scripts de calibragem possam desenhá-la no Skia fora do aparelho. Não faz parte do build do aplicativo.",
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "outDir": "/tmp/lymark-build",
    "rootDir": ".",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "ignoreDeprecations": "6.0"
  },
  "files": [
    "src/features/watermark/stamp-layout.ts",
    "src/features/watermark/preferences.ts",
    "src/features/watermark/build-content.ts"
  ]
}
