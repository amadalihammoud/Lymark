{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "next build",
  "rewrites": [
    {
      "source": "/web",
      "destination": "/web/index.html"
    },
    {
      "source": "/web/",
      "destination": "/web/index.html"
    },
    {
      "source": "/web/((?!assets|.*\..*).*)",
      "destination": "/web/index.html"
    }
  ]
}
