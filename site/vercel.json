{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/canvaskit.wasm",
      "destination": "/web/canvaskit.wasm"
    },
    {
      "source": "/web",
      "destination": "/web/index.html"
    },
    {
      "source": "/web/",
      "destination": "/web/index.html"
    },
    {
      "source": "/web/((?!_expo|assets|canvaskit\\.wasm|.*\\..*).*)",
      "destination": "/web/index.html"
    },
    {
      "source": "/mesa",
      "destination": "/mesa/index.html"
    },
    {
      "source": "/mesa/",
      "destination": "/mesa/index.html"
    },
    {
      "source": "/mesa/((?!assets|.*\\..*).*)",
      "destination": "/mesa/index.html"
    }
  ]
}
