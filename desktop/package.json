{
  "name": "lymark-desktop",
  "version": "1.3.0",
  "description": "Lymark para desktop: carimba hora, data e endereco em fotos de campo.",
  "main": "desktop/main.js",
  "scripts": {
    "compile": "tsc",
    "start": "npm run compile && electron dist/main.js",
    "build": "npm run compile && electron-builder build --win --linux",
    "build:windows": "npm run compile && electron-builder build --win",
    "build:linux": "npm run compile && electron-builder build --linux",
    "build:dir": "npm run compile && electron-builder build --dir",
    "verify:package": "node scripts/verify-package.js dist-electron/win-unpacked ../dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "i18n-js": "^4.4.3"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "~6.0.3"
  }
}
