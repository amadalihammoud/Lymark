{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "noEmitOnError": true
  },
  "include": ["main.ts", "preload.ts", "image-dimensions.ts", "i18n.ts", "menu.ts"],
  "exclude": ["node_modules", "dist", "__tests__"]
}
