{
  "name": "lymark-mesa",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "description": "Mesa Lymark para notebook e PC: carimbo de data, hora e endereço na foto.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/color.test.ts src/lib/exif.test.ts src/lib/read-stamp-code.test.ts src/lib/datetime.test.ts"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@tailwindcss/vite": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
